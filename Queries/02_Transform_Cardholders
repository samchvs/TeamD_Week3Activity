-- ==============================================================
-- DATA TRANSFORMING: Clean and fix birthdays
-- PURPOSE: Convert text dates to real dates AND fix wrong years
-- RULEs: Year ≥2070 OR ≥2008 - subtract 100 years; else keep as-is
-- ==============================================================

-- --------------------------------------------------------------
-- PART 2A: FIX BIRTHDAYS
-- --------------------------------------------------------------
SELECT
  user_id,
-- 2A. Fix birthday: correct year or age where needed
  CASE
    WHEN YEAR(converted_date) >= 2070
      THEN TO_DATE( STRING(YEAR(converted_date) - 100), "yyyy" )
    WHEN YEAR(converted_date) >= 2008
      THEN TO_DATE( STRING(YEAR(converted_date) - 100), "yyyy" )
    ELSE converted_date
  END AS birthday

-- --------------------------------------------------------------
-- PART 2B: CONVERT REGISTRATION DATE STRING TO DATE FORMATE
-- --------------------------------------------------------------


-- --------------------------------------------------------------
-- PART 2C: CONVERT REGISTRATION DATE
-- --------------------------------------------------------------

-- --------------------------------------------------------------
-- COVERSION OF TEXT TO DATE FORMAT
-- --------------------------------------------------------------
FROM (
--2B convert text TO real date: try either short format first or long format backup
  SELECT
    user_id,
    COALESCE(
      TRY_TO_DATE(birthday, "M/d/yy"),
      TRY_TO_DATE(birthday, "MM/dd/yyyy")
    ) AS converted_date
  FROM workspace.default.d2e2_cardholders_raw
)
