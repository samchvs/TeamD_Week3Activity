-- Document (not "fix") receipt_number
SELECT COUNT(DISTINCT receipt_number) AS unique_receipts, COUNT(*) AS total_rows
FROM workspace.default.transactions_csv;
-- confirms: 1 receipt_number = many rows (one per SKU on that receipt), by design




-- Receipt years vs transaction years — confirms the mismatch you noted
SELECT
  YEAR(transaction_date) AS transaction_year,
  YEAR(TRY_TO_TIMESTAMP(receipt_date, 'yyyy-MM-dd HH:mm:ss')) AS receipt_year_iso,
  COUNT(*) AS n
FROM workspace.default.transactions_csv
GROUP BY 1, 2
ORDER BY 1, 2;







-- Unit price outliers via standard deviation (mean +/- 3 stddev = "unusually high")
WITH stats AS (
  SELECT AVG(total_unit_price) AS avg_price, STDDEV(total_unit_price) AS sd_price
  FROM workspace.default.transactions_csv
)
SELECT t.transaction_id, t.product_sku, t.product_brand, t.total_unit_price
FROM workspace.default.transactions_csv t, stats
WHERE t.total_unit_price > stats.avg_price + (3 * stats.sd_price)
ORDER BY t.total_unit_price DESC;





-- Duplicate product names after cleanup (same cleaned SKU, different original spellings)
SELECT
  UPPER(TRIM(REGEXP_REPLACE(product_sku, '[^a-zA-Z0-9 ]', ' '))) AS cleaned_name,
  COUNT(DISTINCT product_sku) AS raw_variants,
  COLLECT_SET(product_sku) AS examples
FROM workspace.default.transactions_csv
GROUP BY 1
HAVING COUNT(DISTINCT product_sku) > 1;
